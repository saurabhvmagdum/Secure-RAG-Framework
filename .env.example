# ──────────────────────────────────────────────────────────────
# ISRO Secure On-Premise RAG Framework — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# All paths must resolve within the air-gapped on-prem environment.
# ──────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=isro-rag-framework
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000"]

# ── Model Paths (on-prem only) ──────────────────────────────
MODEL_STORE_PATH=/opt/isro/models
EMBEDDING_STORE_PATH=/opt/isro/embeddings
EMBEDDING_MODEL_ID=isro-encoder-v2
LLM_MODEL_ID=isro-llm-v1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9

# ── OpenSearch (BM25 Lexical Index) ─────────────────────────
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME
OPENSEARCH_INDEX_PREFIX=isro_rag
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CA_CERT_PATH=/opt/isro/certs/opensearch-ca.pem

# ── Qdrant (Semantic Vector DB) ─────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME
QDRANT_COLLECTION_PREFIX=isro_rag
QDRANT_TLS_ENABLED=true
QDRANT_CA_CERT_PATH=/opt/isro/certs/qdrant-ca.pem

# ── Neo4j (Knowledge Graph) ─────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=isro_rag
NEO4J_ENCRYPTED=true
NEO4J_CA_CERT_PATH=/opt/isro/certs/neo4j-ca.pem

# ── Security & Auth ─────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
AUTH_PROVIDER=internal_jwt

# ── Encryption ──────────────────────────────────────────────
ENCRYPTION_AT_REST_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY_STORE_PATH=/opt/isro/keys
TLS_CERT_PATH=/opt/isro/certs/server.crt
TLS_KEY_PATH=/opt/isro/certs/server.key
TLS_CA_PATH=/opt/isro/certs/ca.crt

# ── Governance ──────────────────────────────────────────────
GOVERNANCE_DEFAULT_THRESHOLD=0.8
GOVERNANCE_HARD_BLOCK_BELOW=0.5
GOVERNANCE_ALLOW_PARTIAL=true

# ── Audit ───────────────────────────────────────────────────
AUDIT_LOG_PATH=/var/log/isro-rag/audit
AUDIT_LOG_ROTATION=daily
AUDIT_LOG_RETENTION_DAYS=365

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
